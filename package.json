{
    "name": "board-games",
    "private": true,
    "scripts": {
        "dev": "pnpm --filter @board-games/api dev",
        "dev:web": "pnpm --filter @board-games/web dev",
        "dev:all": "pnpm run --parallel dev dev:web",
        "build": "pnpm -r build",
        "lint": "eslint 'apps/**/src/**/*.ts' 'packages/**/src/**/*.ts'",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:generate": "pnpm --filter @board-games/db generate",
        "db:migrate": "pnpm --filter @board-games/db migrate",
        "db:push": "pnpm --filter @board-games/db push"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.0.0",
        "prettier": "^3.0.0",
        "typescript": "^5.0.0"
    }
}
